<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:utils="clr-namespace:FrontEnd.Utils"
             x:Class="FrontEnd.Views.vCambiarContrasena"
             Title=""
             Style="{StaticResource PaginaAuth}">

    <ScrollView>
        <VerticalStackLayout Padding="24,8,24,32"
                             Spacing="0"
                             MaximumWidthRequest="440">

            <!-- El título y el subtítulo cambian según desde dónde se abre (ver el .cs). -->
            <Label x:Name="lblTitulo"
                   Text="Crea una nueva contraseña"
                   Style="{StaticResource Titulo}"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label x:Name="lblSubtitulo"
                   Text="Escríbela dos veces para confirmar que no hay errores."
                   Style="{StaticResource Subtitulo}"
                   Margin="0,6,0,32" />

            <!-- Contraseña actual: solo cuando el usuario ya inició sesión -->
            <VerticalStackLayout x:Name="stkContrasenaActual"
                                 IsVisible="False"
                                 Margin="0,0,0,20">
                <Label Text="Contraseña actual"
                       Style="{StaticResource EtiquetaCampo}" />
                <Border Style="{StaticResource CampoContenedor}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry x:Name="txtContrasenaActual"
                               Style="{StaticResource CampoTexto}"
                               Placeholder="Tu contraseña actual"
                               IsPassword="True"
                               MaxLength="50"
                               ReturnType="Next"
                               SemanticProperties.Description="Contraseña actual" />
                        <Button x:Name="btnMostrarActual"
                                Grid.Column="1"
                                Text="Mostrar"
                                Style="{StaticResource BotonEnCampo}"
                                Clicked="OnMostrarActualClicked" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Nueva contraseña -->
            <Label Text="Nueva contraseña"
                   Style="{StaticResource EtiquetaCampo}" />
            <Border Style="{StaticResource CampoContenedor}">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry x:Name="txtNuevaContrasena"
                           Style="{StaticResource CampoTexto}"
                           Placeholder="Nueva contraseña"
                           IsPassword="True"
                           MaxLength="50"
                           ReturnType="Next"
                           SemanticProperties.Description="Nueva contraseña" />
                    <Button x:Name="btnMostrarContrasena"
                            Grid.Column="1"
                            Text="Mostrar"
                            Style="{StaticResource BotonEnCampo}"
                            Clicked="OnMostrarContrasenaClicked" />
                </Grid>
            </Border>
            <utils:RequisitosContrasena x:Name="stkRequisitos" />

            <!-- Confirmar contraseña -->
            <Label Text="Confirmar contraseña"
                   Style="{StaticResource EtiquetaCampo}"
                   Margin="2,20,0,6" />
            <Border Style="{StaticResource CampoContenedor}">
                <Entry x:Name="txtConfirmarContrasena"
                       Style="{StaticResource CampoTexto}"
                       Placeholder="Repite la contraseña"
                       IsPassword="True"
                       MaxLength="50"
                       ReturnType="Done"
                       SemanticProperties.Description="Confirmar contraseña" />
            </Border>

            <Label x:Name="lblMensaje"
                   Style="{StaticResource MensajeError}"
                   Margin="2,12,0,0" />

            <Button x:Name="btnCambiarContrasena"
                    Text="Cambiar contraseña"
                    Style="{StaticResource BotonPrimario}"
                    Margin="0,28,0,0"
                    Clicked="OnCambiarContrasenaClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
