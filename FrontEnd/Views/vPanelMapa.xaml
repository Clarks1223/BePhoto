<?xml version="1.0" encoding="utf-8" ?>
<!-- Encabezado y aviso "Abriendo mapa…". Es lo que se ve entrar al deslizar en vInicio
     y el fondo de vMapa mientras Leaflet carga, para que el paso entre ambas no se note. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FrontEnd.Views.vPanelMapa"
             BackgroundColor="{AppThemeBinding Light={StaticResource FondoClaro}, Dark={StaticResource FondoOscuro}}">
    <Grid RowDefinitions="64,*"
          SafeAreaEdges="None">
        <Grid ColumnDefinitions="48,*"
              Padding="8,8,20,8"
              SafeAreaEdges="None">
            <Path Style="{StaticResource IconoLinea}"
                  Data="M20,12 H4 M11,5 L4,12 L11,19" />
            <Label Grid.Column="1"
                   Text="Mapa de recuerdos"
                   Style="{StaticResource MarcaBarra}"
                   SemanticProperties.HeadingLevel="Level1" />
        </Grid>

        <Grid Grid.Row="1"
              SafeAreaEdges="None"
              BackgroundColor="{AppThemeBinding Light={StaticResource CampoClaro}, Dark={StaticResource CampoOscuro}}">
            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="12">
                <Border Style="{StaticResource LogoMosaico}">
                    <Path Style="{StaticResource LogoIcono}"
                          Data="M20,37 C20,37 8,26 8,16 A12,12 0 0 1 32,16 C32,26 20,37 20,37 Z M20,11.5 A4.5,4.5 0 1 1 20,20.5 A4.5,4.5 0 1 1 20,11.5 Z" />
                </Border>
                <Label Text="Abriendo mapa…"
                       Style="{StaticResource Subtitulo}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentView>
