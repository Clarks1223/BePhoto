<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FrontEnd.Views.vInicio"
             Title="Galería"
             Style="{StaticResource PaginaAuth}"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="None">

    <!-- La galería usa datos de ejemplo hasta que se conecte el backend. -->
    <Grid SafeAreaEdges="None">

        <!-- Pantalla principal -->
        <Grid RowDefinitions="Auto,*"
              SafeAreaEdges="Container">

            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  Padding="20,8,8,8">
                <Label Text="BePhoto"
                       Style="{StaticResource MarcaBarra}"
                       SemanticProperties.HeadingLevel="Level1" />

                <Grid Grid.Column="1"
                      WidthRequest="48"
                      HeightRequest="48"
                      SemanticProperties.Description="Abrir el menú de tu cuenta">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAvatarTapped" />
                    </Grid.GestureRecognizers>
                    <Border Style="{StaticResource Avatar}"
                            WidthRequest="36"
                            HeightRequest="36">
                        <Grid>
                            <Path Style="{StaticResource AvatarSilueta}"
                                  Data="M12,5 A3.5,3.5 0 1 1 12,12 A3.5,3.5 0 1 1 12,5 Z M5.5,19.5 C5.5,16.2 8.4,14.5 12,14.5 C15.6,14.5 18.5,16.2 18.5,19.5" />
                            <Image x:Name="imgAvatar"
                                   Aspect="AspectFill" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="1"
                  RowDefinitions="Auto,*,Auto"
                  Padding="24,12,24,0">
                <VerticalStackLayout Grid.Row="0"
                                     Spacing="0">
                    <Label Text="Mis recuerdos"
                           Style="{StaticResource Titulo}"
                           FontSize="28"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Tus lugares favoritos, guardados en fotos."
                           Style="{StaticResource Subtitulo}"
                           Margin="0,4,0,18" />

                    <Border Style="{StaticResource CampoContenedor}"
                            Padding="14,0">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="10">
                            <Path Style="{StaticResource IconoLinea}"
                                  Data="M15.5,15.5 L21,21 M10.5,18 A7.5,7.5 0 1 1 10.5,3 A7.5,7.5 0 0 1 10.5,18 Z" />
                            <Entry x:Name="txtBusqueda"
                                   Grid.Column="1"
                                   Style="{StaticResource CampoTexto}"
                                   Placeholder="Buscar por título o fecha"
                                   ReturnType="Search"
                                   TextChanged="OnBusquedaTextoCambiado"
                                   SemanticProperties.Description="Buscar recuerdos por título o fecha" />
                        </Grid>
                    </Border>
                    <Label x:Name="lblConteo"
                           Text="3 recuerdos"
                           Style="{StaticResource EtiquetaDato}"
                           Margin="2,14,0,0" />
                </VerticalStackLayout>

                <Grid Grid.Row="1"
                      Margin="0,12,0,12">
                    <CollectionView x:Name="cvRecuerdos"
                                    SelectionMode="Single"
                                    SelectionChanged="OnRecuerdoSeleccionado">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical"
                                             Span="2"
                                             HorizontalItemSpacing="12"
                                             VerticalItemSpacing="16" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource FondoClaro}, Dark={StaticResource CampoOscuro}}"
                                        Stroke="{AppThemeBinding Light={StaticResource BordeClaro}, Dark={StaticResource BordeOscuro}}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 18"
                                        Padding="0">
                                    <Grid RowDefinitions="140,Auto">
                                        <Image Grid.Row="0"
                                               Source="{Binding Foto}"
                                               Aspect="AspectFill" />
                                        <VerticalStackLayout Grid.Row="1"
                                                             Padding="12,10,12,12"
                                                             Spacing="3">
                                            <Label Text="{Binding Titulo}"
                                                   Style="{StaticResource ValorDato}"
                                                   FontAttributes="Bold"
                                                   MaxLines="1" />
                                            <Label Text="{Binding FechaTexto}"
                                                   Style="{StaticResource EtiquetaDato}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <VerticalStackLayout x:Name="stkEstadoVacio"
                                         IsVisible="False"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         MaximumWidthRequest="320"
                                         Spacing="8">
                        <Border Style="{StaticResource LogoMosaico}"
                                WidthRequest="64"
                                HeightRequest="64"
                                StrokeShape="RoundRectangle 20">
                            <Path Style="{StaticResource LogoIcono}"
                                  WidthRequest="34"
                                  HeightRequest="34"
                                  Data="M8,13 H13 L15.5,9 H24.5 L27,13 H32 A4,4 0 0 1 36,17 V30 A4,4 0 0 1 32,34 H8 A4,4 0 0 1 4,30 V17 A4,4 0 0 1 8,13 Z M20,16.5 A6.5,6.5 0 1 0 20,29.5 A6.5,6.5 0 1 0 20,16.5 Z" />
                        </Border>
                        <Label x:Name="lblEstadoVacio"
                               Text="Aún no tienes recuerdos guardados"
                               Style="{StaticResource Titulo}"
                               FontSize="20"
                               HorizontalTextAlignment="Center"
                               Margin="0,12,0,0" />
                        <Label Text="Captura una foto para guardar el lugar y volver a él cuando quieras."
                               Style="{StaticResource Subtitulo}"
                               HorizontalTextAlignment="Center" />
                        <Button x:Name="btnEstadoVacio"
                                Text="Capturar recuerdo"
                                Style="{StaticResource BotonPrimario}"
                                Margin="0,12,0,0"
                                Clicked="OnAccionEstadoVacioClicked" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Grid.Row="2">
                    <BoxView Style="{StaticResource Separador}"
                             Margin="-24,0" />
                    <Button Text="＋  Capturar recuerdo"
                            Style="{StaticResource BotonPrimario}"
                            Margin="0,12,0,16"
                            Clicked="OnCapturarClicked" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- Capa 2: menú de la cuenta -->
        <Grid x:Name="grdMenu"
              IsVisible="False"
              SafeAreaEdges="None">

            <!-- Velo oscuro: tocarlo cierra el menú -->
            <BoxView x:Name="bxVelo"
                     Color="Black"
                     Opacity="0">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCerrarMenuTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Grid SafeAreaEdges="Container"
                  VerticalOptions="Start">
                <Border x:Name="brdMenu"
                        Style="{StaticResource TarjetaMenu}"
                        VerticalOptions="Start"
                        Margin="12,8,12,0"
                        MaximumWidthRequest="440">
                    <VerticalStackLayout Spacing="0">

                        <!-- Encabezado: cerrar a la izquierda y marca al centro -->
                        <Grid ColumnDefinitions="48,*,48"
                              HeightRequest="48">
                            <Grid x:Name="btnCerrarMenu"
                                  SemanticProperties.Description="Cerrar el menú">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCerrarMenuTapped" />
                                </Grid.GestureRecognizers>
                                <Path Style="{StaticResource IconoLinea}"
                                      Data="M6,6 L18,18 M18,6 L6,18" />
                            </Grid>
                            <Label Grid.Column="1"
                                   Text="BePhoto"
                                   Style="{StaticResource MarcaBarra}"
                                   FontSize="18"
                                   HorizontalTextAlignment="Center" />
                        </Grid>

                        <!-- Cuenta: foto y saludo -->
                        <VerticalStackLayout Padding="16,8,16,20"
                                             Spacing="0">
                            <Border Style="{StaticResource Avatar}"
                                    WidthRequest="64"
                                    HeightRequest="64">
                                <Grid>
                                    <Path Style="{StaticResource AvatarSilueta}"
                                          StrokeThickness="2.6"
                                          Data="M32,15 A8,8 0 1 1 32,31 A8,8 0 1 1 32,15 Z M17,51 C17,43 23.5,38 32,38 C40.5,38 47,43 47,51" />
                                    <Image x:Name="imgAvatarMenu"
                                           Aspect="AspectFill" />
                                </Grid>
                            </Border>
                            <Label x:Name="lblNombreUsuario"
                                   Text="Tu cuenta"
                                   Style="{StaticResource Titulo}"
                                   FontSize="20"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,12,0,0" />
                        </VerticalStackLayout>

                        <!-- Datos del usuario (solo lectura) -->
                        <Border Style="{StaticResource GrupoOpciones}"
                                Margin="0,0,0,8">
                            <VerticalStackLayout Spacing="0">
                                <VerticalStackLayout Style="{StaticResource FilaDato}">
                                    <Label Text="Nombre"
                                           Style="{StaticResource EtiquetaDato}" />
                                    <Label x:Name="lblNombre"
                                           Text="—"
                                           Style="{StaticResource ValorDato}" />
                                </VerticalStackLayout>

                                <BoxView Style="{StaticResource Separador}"
                                         Margin="16,0,0,0" />

                                <VerticalStackLayout Style="{StaticResource FilaDato}">
                                    <Label Text="Apellido"
                                           Style="{StaticResource EtiquetaDato}" />
                                    <Label x:Name="lblApellido"
                                           Text="—"
                                           Style="{StaticResource ValorDato}" />
                                </VerticalStackLayout>

                                <BoxView Style="{StaticResource Separador}"
                                         Margin="16,0,0,0" />

                                <VerticalStackLayout Style="{StaticResource FilaDato}">
                                    <Label Text="Correo electrónico"
                                           Style="{StaticResource EtiquetaDato}" />
                                    <Label x:Name="lblCorreo"
                                           Text="—"
                                           Style="{StaticResource ValorDato}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Opciones -->
                        <Border Style="{StaticResource GrupoOpciones}">
                            <VerticalStackLayout Spacing="0">
                                <Grid x:Name="btnCambiarContrasena"
                                      ColumnDefinitions="56,*"
                                      HeightRequest="56"
                                      SemanticProperties.Description="Cambiar contraseña">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCambiarContrasenaTapped" />
                                    </Grid.GestureRecognizers>
                                    <Path Style="{StaticResource IconoLinea}"
                                          Data="M8,11 V8 A4,4 0 0 1 16,8 V11 M6,11 H18 A1,1 0 0 1 19,12 V20 A1,1 0 0 1 18,21 H6 A1,1 0 0 1 5,20 V12 A1,1 0 0 1 6,11 Z" />
                                    <Label Grid.Column="1"
                                           Text="Cambiar contraseña"
                                           Style="{StaticResource TextoOpcion}" />
                                </Grid>

                                <BoxView Style="{StaticResource Separador}"
                                         Margin="56,0,0,0" />

                                <Grid x:Name="btnCerrarSesion"
                                      ColumnDefinitions="56,*"
                                      HeightRequest="56"
                                      SemanticProperties.Description="Cerrar sesión">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCerrarSesionTapped" />
                                    </Grid.GestureRecognizers>
                                    <Path Style="{StaticResource IconoLinea}"
                                          Data="M10,4 H6 A1,1 0 0 0 5,5 V19 A1,1 0 0 0 6,20 H10 M15,8 L19,12 L15,16 M19,12 H10" />
                                    <Label Grid.Column="1"
                                           Text="Cerrar sesión"
                                           Style="{StaticResource TextoOpcion}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
