<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BePhoto.Api</RootNamespace>
    <!-- Para guardar las claves fuera del repositorio con "dotnet user-secrets". -->
    <UserSecretsId>d59074ef-b399-410f-af43-2bd151e5b567</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- "10.*" = la última versión 10.x disponible -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
    <PackageReference Include="CloudinaryDotNet" Version="1.*" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.*" />
  </ItemGroup>

</Project>
